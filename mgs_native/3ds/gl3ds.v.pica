; gl3ds.cpp's vertex shader: fixed-function transform only (lighting and fog aren't used by the game in play).
; projection already contains the 3DS screen rotation, the PICA depth range and the per-eye stereo shift.
.fvec projection[4], modelView[4]

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.alias inpos v0
.alias inclr v1
.alias intc0 v2
.alias intc1 v3

.proc main
    dp4 r0.x, modelView[0], inpos
    dp4 r0.y, modelView[1], inpos
    dp4 r0.z, modelView[2], inpos
    dp4 r0.w, modelView[3], inpos

    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    mov outclr, inclr
    mov outtc0, intc0
    mov outtc1, intc1
    end
.end
